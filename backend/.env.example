# SQL Server (Azure SQL)
DB_SERVER=your-server.database.windows.net
DB_DATABASE=your-database-name
DB_USER=your-db-user
DB_PASSWORD=your_password_here
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Server
PORT=3500

# Encryption (AES-256-GCM for API key storage)
ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# Neo4j (AuraDB Free) — sandbox/evaluation only. NOT used by the running app
# (no route, migration, or health check touches this yet — Azure SQL above
# remains the real database). Only needed to run `npm run verify:neo4j`.
# Create a free instance at https://console.neo4j.io — its downloadable
# credentials file uses exactly this NEO4J_/AURA_ variable naming, so you
# can paste it in as-is (URI/username/password are shown once at creation).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-generated-password
NEO4J_DATABASE=neo4j
# Aura management-plane metadata — not used by the driver/verify script,
# kept only for reference (which instance this is).
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=your-instance-name
