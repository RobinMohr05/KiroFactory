# Server
PORT=3500

# Encryption (AES-256-GCM for API key storage)
ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# Session JWT signing/verification secret. REQUIRED in production — the server
# refuses to start (throws at boot) if this is unset/empty when
# NODE_ENV=production, since falling back to a public literal would let anyone
# forge a session token. Outside production a dev fallback is used, so it's
# optional for local development. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-random-secret-string

# Neo4j (AuraDB Free) — the application database. Everyone (production and every
# developer) connects to the same shared instance; see backend/README.md's "Run
# entirely on localhost" section. Create a free instance at https://console.neo4j.io —
# its downloadable credentials file uses exactly this NEO4J_/AURA_ variable naming,
# so you can paste it in as-is (URI/username/password are shown once at creation).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-generated-password
NEO4J_DATABASE=neo4j
# Aura management-plane metadata — not used by the driver, kept only for
# reference (which instance this is).
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=your-instance-name

# Webhook shared secret — gates POST /api/webhooks/tasks. When unset, the
# endpoint returns 503 (not configured). Set to a random string to enable it.
WEBHOOK_SECRET=

# kiro-cli model detection timeout (ms) — how long GET /api/models waits for
# `kiro-cli acp` session/new to advertise its available models before giving up
# and returning the auto-only fallback. Defaults to 45000 (45s) if unset, with
# headroom above the measured ~27s cold-start latency of a fresh kiro-cli
# (before its local cache/auth state is warm). Only raise/lower this if you see
# detection timing out (GET /api/models/diagnostics reports lastDetectionCode
# "timeout") or want to fail faster in an environment where kiro-cli is absent.
MODEL_DETECTION_TIMEOUT_MS=45000