# Server
PORT=3500

# Encryption (AES-256-GCM for API key storage)
ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# Neo4j (AuraDB Free) — the application database. Everyone (production and every
# developer) connects to the same shared instance; see backend/README.md's "Run
# entirely on localhost" section. Create a free instance at https://console.neo4j.io —
# its downloadable credentials file uses exactly this NEO4J_/AURA_ variable naming,
# so you can paste it in as-is (URI/username/password are shown once at creation).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-generated-password
NEO4J_DATABASE=neo4j
# Aura management-plane metadata — not used by the driver, kept only for
# reference (which instance this is).
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=your-instance-name

# Webhook shared secret — gates POST /api/webhooks/tasks. When unset, the
# endpoint returns 503 (not configured). Set to a random string to enable it.
WEBHOOK_SECRET=