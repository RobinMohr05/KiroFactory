# SQL Server Express LocalDB (fully offline, Windows only)
# Copy this file to .env for local development without Azure SQL.
#
# Prerequisites:
#   1. Install SQL Server Express LocalDB (see README.md § Local development with LocalDB)
#   2. Create the database:
#      sqlcmd -S "(localdb)\MSSQLLocalDB" -Q "CREATE DATABASE TecFactory;"
#   3. Run migrations: npm run migrate

DB_SERVER=(localdb)\\MSSQLLocalDB
DB_DATABASE=TecFactory
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Server
PORT=3500

# Worker mode — use "local" to spawn kiro-cli as a child process (no Azure Container Apps)
WORKER_MODE=local

# Encryption key for stored secrets (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
