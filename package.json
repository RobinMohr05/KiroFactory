{
  "name": "vibecode-heaven",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -s first \"npm run dev -w backend\" \"npm run wait-for-backend && npm run dev -w frontend\"",
    "wait-for-backend": "wait-on http://localhost:3500/api/health",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "concurrently": "^9.1.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "wait-on": "7.2.0"
  },
  "overrides": {
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.17.33"
  }
}
